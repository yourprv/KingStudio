# PostgreSQL used by Drizzle for projects, credit balances, and shared model quota.
DATABASE_URL=

# Server-only PRV AI API base URL. Kite validates PRV bearer tokens and reads
# account and plan data through PRV AI's server-to-server SSO endpoints.
PRV_API_URL=
KITE_SSO_SHARED_SECRET=
KITE_SESSION_SECRET=

# Kite's Supabase project is still used for its own PostgreSQL and Storage.
SUPABASE_URL=

# Server only. Prefer a new Supabase secret key. Never use NEXT_PUBLIC_ here.
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=workspace

# Server only. Do not commit or expose this value to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=15
GEMINI_TPM=250000
GEMINI_RPD=500
